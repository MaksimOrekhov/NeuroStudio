{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept",
    "frames"
  ],
  "properties": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "titleRu",
        "description",
        "descriptionRu",
        "heroine"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "English title"
        },
        "titleRu": {
          "type": "string",
          "description": "Natural Russian title for the interface"
        },
        "description": {
          "type": "string",
          "description": "English one- or two-sentence description"
        },
        "descriptionRu": {
          "type": "string",
          "description": "Natural Russian description for the interface"
        },
        "heroine": {
          "type": "string",
          "description": "Fixed profile of the single adult heroine: age, face, hair, eyes, distinctive traits, main outfit"
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "model",
          "summary",
          "summaryRu",
          "positive"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "model": {
            "type": "string",
            "enum": [
              "crimson-oath",
              "duskrose"
            ]
          },
          "summary": {
            "type": "string",
            "description": "English one-sentence shot brief: where she is, what she does, how it is seen"
          },
          "summaryRu": {
            "type": "string",
            "description": "The same shot brief in natural Russian for the interface"
          },
          "positive": {
            "type": "string",
            "description": "English positive prompt"
          }
        }
      }
    }
  }
}
