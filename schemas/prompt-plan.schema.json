{
  "type": "object",
  "additionalProperties": false,
  "required": ["concept", "frames"],
  "properties": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "heroine"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "heroine": { "type": "string", "description": "Fixed look of the single adult heroine (age 21+) shared by all frames" }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "model", "summary", "positive", "negative"],
        "properties": {
          "frame": { "type": "integer", "minimum": 1, "maximum": 4 },
          "model": { "type": "string", "enum": ["crimson-oath", "duskrose"] },
          "summary": { "type": "string" },
          "positive": { "type": "string" },
          "negative": { "type": "string" }
        }
      }
    }
  }
}
